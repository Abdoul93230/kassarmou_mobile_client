# Copier en .env.local pour surcharger en développement (sinon : production).
# Toutes les URLs sont lues dans src/config/env.js — ne jamais les écrire en dur ailleurs.

# EXPO_PUBLIC_API_URL=https://api.ihambaobab.com
# EXPO_PUBLIC_SOCKET_URL=https://api.ihambaobab.com
# EXPO_PUBLIC_SITE_URL=https://www.ihambaobab.com

# Backend local (remplacer par l'IP de votre PC sur le réseau Wi-Fi) :
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8083

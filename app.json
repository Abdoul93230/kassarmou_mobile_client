{
  "expo": {
    "name": "Ihambaobab",
    "slug": "ihambaobab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "ihambaobab",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ihambaobab.mobile",
      "associatedDomains": [
        "applinks:ihambaobab.com",
        "applinks:www.ihambaobab.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.ihambaobab.mobile",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "ihambaobab.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "www.ihambaobab.com",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "cc2a64e6-a646-43b0-9c43-ba6720c574a0"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/cc2a64e6-a646-43b0-9c43-ba6720c574a0"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-status-bar",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo-horizontal.png",
          "imageWidth": 230,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ihambaobab utilise votre position uniquement pour trouver votre quartier de livraison.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}

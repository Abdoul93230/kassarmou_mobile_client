{
  "expo": {
    "name": "Kassarmou",
    "slug": "kassarmou-mobile-client",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/vraisLogo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "kassarmoumarket",
    "splash": {
      "image": "./assets/vraisLogo.png",
      "resizeMode": "contain",
      "backgroundColor": "#30A08B"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kassarmou.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "L'application a besoin d'accéder à votre caméra pour prendre des photos.",
        "NSPhotoLibraryUsageDescription": "L'application a besoin d'accéder à vos photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/vraisLogo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.kassarmou.mobile",
      "versionCode": 3,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "33730fc4-2f3a-4498-8887-70bd090e6c37"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/33730fc4-2f3a-4498-8887-70bd090e6c37"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      "expo-web-browser",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.kassarmou.mobile",
          "enableGooglePay": true
        }
      ]
    ]
  }
}
